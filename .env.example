# Copy to .env.local and fill in. .env.local is gitignored -- never commit it.

# ---------------------------------------------------------------------------
# Postgres (required)
# ---------------------------------------------------------------------------
# MUST be a Supavisor pooler URL, not the direct connection: Vercel has no IPv6
# and Supabase free-tier direct connections are IPv6-only.
#
# Supabase dashboard -> your project -> Connect -> Transaction pooler (port 6543)
# If you never set a database password, reset it under Settings -> Database.
#
# Shape:
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# Stripe (optional, but this is what makes the money action real)
# ---------------------------------------------------------------------------
# TEST MODE ONLY. https://dashboard.stripe.com/test/apikeys
# Without it the app still runs: refunds fall back to ledger-only mode and the
# UI says so plainly rather than pretending an external call happened.
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Gemini (optional)
# ---------------------------------------------------------------------------
# https://aistudio.google.com/apikey -- free tier, no credit card.
# Drives the natural-language planner and the consequence model. Without it the
# app uses the built-in preset intents and a rules-based consequence model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Signs the sandbox cookie. Any long random string; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Protects the keep-alive cron route. Any long random string.
CRON_SECRET=
